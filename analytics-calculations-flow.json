                "1b73011db43bbd92",
                "3bf729282631f43e"
            ]
        ]
    },
    {
        "id": "f3bf1db735d7fc09",
        "type": "function",
        "z": "edc620f392ac528a",
        "name": "Calculate RUL",
        "func": "const CRITICAL_THRESHOLD = 50;\n\nlet history = flow.get(\"healthHistory\") || {};\nconst machine = msg.payload.machine;\nconst records = history[machine] || [];\n\nif (records.length < 5) {\n    return null;\n}\n\nconst recent = records.slice(-10);\nconst first = recent[0];\nconst last = recent[recent.length - 1];\n\nconst scoreDrop = first.score - last.score;\nconst timeElapsedMinutes = (last.time - first.time) / 1000 / 60;\n\nlet rulMinutes = null;\n\nif (scoreDrop > 0 && timeElapsedMinutes > 0) {\n    const declineRatePerMinute = scoreDrop / timeElapsedMinutes;\n    const distanceToFailure = last.score - CRITICAL_THRESHOLD;\n    rulMinutes = distanceToFailure > 0 ? distanceToFailure / declineRatePerMinute : 0;\n}\n\nmsg.payload = {\n    machine: machine,\n    rul_minutes: rulMinutes !== null ? Math.round(rulMinutes * 10) / 10 : null,\n    currentHealthScore: last.score,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
