    {
        "id": "85fd4cf6ea6bba1c",
        "type": "function",
        "z": "edc620f392ac528a",
        "name": "Calculate MTBF & MTTR",
        "func": "const CRITICAL_THRESHOLD = 50; \n\nlet history = flow.get(\"healthHistory\") || {};\nconst machine = msg.payload.machine;\nconst records = history[machine] || [];\n\nif (records.length < 2) {\n    return null; // not enough data yet\n}\n\nlet failures = [];\nlet inFailure = false;\nlet failureStart = null;\n\nfor (let i = 0; i < records.length; i++) {\n    const r = records[i];\n    if (r.score < CRITICAL_THRESHOLD && !inFailure) {\n        inFailure = true;\n        failureStart = r.time;\n    } else if (r.score >= CRITICAL_THRESHOLD && inFailure) {\n        inFailure = false;\n        failures.push({ start: failureStart, end: r.time });\n    }\n}\n\nlet mtbf = null;\nlet mttr = null;\n\nif (failures.length > 0) {\n    const totalDowntime = failures.reduce((sum, f) => sum + (f.end - f.start), 0);\n    mttr = (totalDowntime / failures.length) / 1000; // seconds\n\n    if (failures.length > 1) {\n        let gaps = [];\n        for (let i = 1; i < failures.length; i++) {\n            gaps.push(failures[i].start - failures[i - 1].start);\n        }\n        const totalGap = gaps.reduce((a, b) => a + b, 0);\n        mtbf = (totalGap / gaps.length) / 1000; // seconds\n    } else {\n        const totalTime = (records[records.length - 1].time - records[0].time) / 1000;\n        mtbf = totalTime;\n    }\n}\n\nmsg.payload = {\n    machine: machine,\n    mtbf_seconds: mtbf ? Math.round(mtbf) : null,\n    mttr_seconds: mttr ? Math.round(mttr) : null,\n    failureCount: failures.length,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
        "y": 180,
        "wires": [
