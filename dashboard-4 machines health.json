  {
    "id": "e5191b9b43b20c5d",
    "type": "function",
    "z": "dc371126ceaad643",
    "name": "Health Score",
    "func": "let ranking = flow.get(\"ranking\") || {};\n\n// Always clean out any bad/undefined entry first, every run\ndelete ranking[\"undefined\"];\n\nconst topicParts = msg.topic.split(\"/\");\nconst machineName = topicParts[topicParts.length - 2];\n\n// Skip processing entirely if the machine name isn't valid\nif (!machineName || machineName === \"undefined\" || typeof msg.payload !== \"number\") {\n    return null;\n}\n\nranking[machineName] = msg.payload;\n\nlet arr = [];\nfor (let machine in ranking) {\n    arr.push({ machine: machine, health: ranking[machine] });\n}\n\narr.sort((a, b) => b.health - a.health);\n\narr = arr.map((item, index) => ({\n    Rank: index + 1,\n    Machine: item.machine,\n    Health: item.health\n}));\n\nmsg.payload = arr;\nflow.set(\"ranking\", ranking);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 830,
    "y": 3180,
    "wires": [
