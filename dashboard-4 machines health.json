  {
    "id": "974e28b7f0f98add",
    "type": "function",
    "z": "dc371126ceaad643",
    "name": "Calculate MTBF & MTTR",
    "func": "const CRITICAL_THRESHOLD = 50; \n\nlet history = flow.get(\"healthHistory\") || {};\nconst machine = msg.payload.machine;\nconst records = history[machine] || [];\n\nif (records.length < 2) {\n    return null; // not enough data yet\n}\n\nlet failures = [];\nlet inFailure = false;\nlet failureStart = null;\n\nfor (let i = 0; i < records.length; i++) {\n    const r = records[i];\n    if (r.score < CRITICAL_THRESHOLD && !inFailure) {\n        inFailure = true;\n        failureStart = r.time;\n    } else if (r.score >= CRITICAL_THRESHOLD && inFailure) {\n        inFailure = false;\n        failures.push({ start: failureStart, end: r.time });\n    }\n}\n\nlet mtbf = null;\nlet mttr = null;\n\nif (failures.length > 0) {\n    const totalDowntime = failures.reduce((sum, f) => sum + (f.end - f.start), 0);\n    mttr = (totalDowntime / failures.length) / 1000; // seconds\n\n    if (failures.length > 1) {\n        let gaps = [];\n        for (let i = 1; i < failures.length; i++) {\n            gaps.push(failures[i].start - failures[i - 1].start);\n        }\n        const totalGap = gaps.reduce((a, b) => a + b, 0);\n        mtbf = (totalGap / gaps.length) / 1000; // seconds\n    } else {\n        const totalTime = (records[records.length - 1].time - records[0].time) / 1000;\n        mtbf = totalTime;\n    }\n}\n\nmsg.payload = {\n    machine: machine,\n    mtbf_seconds: mtbf !== null ? Math.round(mtbf) : 0,\n    mttr_seconds: mttr !== null ? Math.round(mttr) : 0,\n    failureCount: failures.length,\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 890,
    "y": 180,
    "wires": [
      [
        "d4e59e7c69d8e14d",
        "55c8951b897f60d3"
      ]
    ]
  },
  {
    "id": "c37787fb70340b90",
    "type": "function",
    "z": "dc371126ceaad643",
    "name": "Calculate RUL",
    "func": "const CRITICAL_THRESHOLD = 50;\n\nlet history = flow.get(\"healthHistory\") || {};\nconst machine = msg.payload.machine;\nconst records = history[machine] || [];\n\nif (records.length < 2) {\n    return null;\n}\n\nconst recent = records.slice(-10);\nconst first = recent[0];\nconst last = recent[recent.length - 1];\n\nconst scoreDrop = first.score - last.score;\nconst timeElapsedMinutes = (last.time - first.time) / 1000 / 60;\n\nlet rulMinutes = null;\n\nif (scoreDrop > 0 && timeElapsedMinutes > 0) {\n    const declineRatePerMinute = scoreDrop / timeElapsedMinutes;\n    const distanceToFailure = last.score - CRITICAL_THRESHOLD;\n    rulMinutes = distanceToFailure > 0 ? distanceToFailure / declineRatePerMinute : 0;\n}\n\nmsg.payload = {\n    machine: machine,\n    rul_minutes: rulMinutes !== null ? Math.round(rulMinutes * 10) / 10 : null,\n    currentHealthScore: last.score,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 900,
    "y": 280,
    "wires": [
      [
        "3cfd9d9f14c36117",
        "0fa96d6eea348496"
      ]
    ]
