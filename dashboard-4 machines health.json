  {
    "id": "b21d5126b1a79fa2",
    "type": "function",
    "z": "dc371126ceaad643",
    "name": "Track History - Machine1",
    "func": "\nconst machine = \"machine1\"; \n\nlet history = flow.get(\"healthHistory\") || {};\nconst score = msg.payload.health_score;\nconst now = Date.now();\n\nif (!history[machine]) {\n    history[machine] = [];\n}\n\nhistory[machine].push({ score: score, time: now });\n\nif (history[machine].length > 200) {\n    history[machine].shift(); // keep memory bounded\n}\n\nflow.set(\"healthHistory\", history);\n\nmsg.payload = { machine: machine };\nreturn msg;",
